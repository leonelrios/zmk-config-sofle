#include "mi_sofle.dtsi"

&default_transform {
    col-offset = <6>;
};

&kscan0 {
    col-gpios
        = <&gpio0 9  GPIO_ACTIVE_HIGH>   // C0: Arduino 10 = P0.09
        , <&gpio0 10 GPIO_ACTIVE_HIGH>   // C1: Arduino 11 = P0.10
        , <&gpio1 11 GPIO_ACTIVE_HIGH>   // C2: Arduino 12 = P1.11
        , <&gpio1 7  GPIO_ACTIVE_HIGH>   // C3: Arduino 20 = P1.07
        , <&gpio0 20 GPIO_ACTIVE_HIGH>   // C4: Arduino 3  = P0.20
        , <&gpio0 8  GPIO_ACTIVE_HIGH>   // C5: Arduino 1  = P0.08
        ;

    row-gpios
        = <&gpio0 6  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // R0: Arduino 0  = P0.06
        , <&gpio0 17 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // R1: Arduino 2  = P0.17
        , <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // R2: Arduino 4  = P0.22
        , <&gpio1 6  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // R3: Arduino 9  = P1.06
        , <&gpio1 1  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // R4: Arduino 18 = P1.01
        ;
};


// ---------------- OLED SSD1306 128x32 (solo mitad derecha) ----------------
// Tu sketch: SDA = Arduino 16 = P0.29, SCL = Arduino 13 = P1.13

/ {
    chosen {
        zephyr,display = &oled;
    };
};

&pinctrl {
    i2c0_default: i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 29)>,
                    <NRF_PSEL(TWIM_SCL, 1, 13)>;
        };
    };

    i2c0_sleep: i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 29)>,
                    <NRF_PSEL(TWIM_SCL, 1, 13)>;
            low-power-enable;
        };
    };
};

&i2c0 {
    status = "okay";

    oled: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        width = <128>;
        height = <32>;
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <31>;
        segment-remap;
        com-invdir;
        com-sequential;
        prechargep = <0x22>;
        inversion-on;          // fondo negro, dibujos en blanco
    };
};
