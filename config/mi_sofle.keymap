#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
&kp N1     &kp N2  &kp N3  &kp N4   &kp N5    &kp N6     &kp N7    &kp N8  &kp N9     &kp N0    &kp MINUS  &kp EQUAL
&kp TILDE  &kp Q   &kp W   &kp E    &kp R     &kp T      &kp Y     &kp U   &kp I      &kp O     &kp P      &kp FSLH
&kp BSLH   &kp A   &kp S   &kp D    &kp F     &kp G      &kp H     &kp J   &kp K      &kp L     &kp SEMI   &kp SQT
&kp FSLH   &kp Z   &kp X   &kp C    &kp V     &kp B      &kp N     &kp M   &kp COMMA  &kp DOT   &kp LBKT   &kp RBKT
           &kp LCTRL  &kp LALT  &kp LGUI  &kp LSHFT  &kp TAB    &mo 1  &kp SPACE  &kp BSPC  &kp RET  &kp ESC
            >;
        };

        mo {
            display-name = "MO";
            bindings = <
&kp EXCL   &kp AT  &kp HASH  &kp DLLR  &kp PRCNT  &kp CARET  &kp AMPS  &kp STAR  &kp LPAR   &kp RPAR  &kp UNDER  &kp PLUS
&kp GRAVE  &kp ESC &kp W     &kp E     &kp R      &kp T      &kp Y     &kp U     &kp UP     &kp O     &kp P      &kp QMARK
&kp PIPE   &kp A   &kp S     &kp D     &kp F      &kp G      &kp H     &kp LEFT  &kp DOWN   &kp RIGHT &kp COLON  &kp DQT
&kp QMARK  &kp Z   &kp X     &kp C     &kp V      &kp B      &kp N     &kp M     &kp LT     &kp GT    &kp LBRC   &kp RBRC
           &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &none  &trans
            >;
        };
    };
};
